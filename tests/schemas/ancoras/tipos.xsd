<?xml version="1.0" encoding="UTF-8"?>
<!-- Schema de teste (não oficial): padrões com ^ e $ usados como âncoras,
     como TSSerieDPS da NFS-e nacional 1.01; ver validar.c -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:teste:ancoras" xmlns="urn:teste:ancoras"
           elementFormDefault="qualified">
  <xs:simpleType name="TSerie">
    <xs:restriction base="xs:string">
      <xs:maxLength value="5"/>
      <xs:pattern value="^0{0,4}\d{1,5}$"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TPreco">
    <xs:restriction base="xs:string">
      <xs:pattern value='^[0-9]+\.[0-9]{2}$' />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TSemAncora">
    <xs:restriction base="xs:string">
      <xs:pattern value="[^a-z]{2}"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
