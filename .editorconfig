# Configuração de editores (https://editorconfig.org)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h}]
indent_style = tab
indent_size = 8
max_line_length = 80

[Makefile]
indent_style = tab

[*.{yml,yaml,md,py}]
indent_style = space
indent_size = 4

[*.yml]
indent_size = 2

[tests/schemas/**.xsd]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
